{
  "name": "sandbox-node",
  "version": "1.0.0",
  "description": "Node.js sandbox environment",
  "packageManager": "pnpm@10.27.0",
  "main": "src/index.js",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this repo.'); process.exit(1); }\"",
    "check": "node --check src/index.js && node --check test/server.test.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1"
  }
}
